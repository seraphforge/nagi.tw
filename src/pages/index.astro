---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotesPreview from '../components/NotesPreview.astro';
import { languageLabel } from '../lib/previews';
import { fetchNotesRss } from '../lib/notes-rss';

const recent = (await fetchNotesRss()).slice(0, 3);
const groups = recent;

const selectedWork = groups.map((group) => ({
  group,
  label: `${group.topic} · Notes`,
  context: group.variants.zh.data.description ?? 'Read the latest note on Notes.',
}));

const practiceThreads = [
  ['01', 'Medical / Healthcare', '從醫療現場與臨床需求出發，理解科技真正需要回應的問題。'],
  ['02', 'AI / Research', '把 AI、Edge AI 與跨領域題目當成持續提問和實驗的方向。'],
  ['03', 'Engineering / Embedded', '透過硬體、Raspberry Pi、Homelab 與系統實作累積工程經驗。'],
  ['04', 'Security', '從 CTF、惡意程式分析到產業觀察，探索安全問題的不同面向。'],
  ['05', 'Projects / Competitions', '在專案、競賽與團隊協作裡，把想法變成能被測試的東西。'],
] as const;

const practiceBlocks = [practiceThreads[0], practiceThreads[1], practiceThreads[2], practiceThreads[4]] as const;
const securityContext = practiceThreads[3];

const currentThreads = [
  ['Medical technology', '持續理解醫療系統、臨床流程與實際使用需求。'],
  ['Edge AI & embedded', '探索 Edge AI、Raspberry Pi 與嵌入式實驗能連起哪些問題。'],
  ['Homelab & systems', '透過 Homelab 整理對基礎設施與工程系統的理解。'],
  ['Competitions & teams', '在比賽準備與團隊合作裡累積實作和溝通經驗。'],
] as const;
---

<BaseLayout>
  <div class="research-board">
  <section class="board-region identity-hero">
    <p class="eyebrow">Nagi.tw · Personal studio</p>
    <h1>Nagi</h1>
    <p class="identity-line">Student researcher &amp; builder.</p>
    <p class="identity-intro">
      研究醫療科技、AI、工程系統、嵌入式與資安，也記錄專案、競賽，以及一路上的想法。
    </p>
    <nav class="hero-links" aria-label="Homepage sections">
      <a href="#selected-work">Selected work</a>
      <a href="#notes">Notes</a>
      <a href="#about">About</a>
    </nav>
    <div class="hero-mascot" aria-label="Nagi mascot">
      <details class="nagi-mascot__easter-egg">
        <summary aria-label="Nagi penguin — build quietly">
          <svg class="nagi-penguin" viewBox="0 0 24 24" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
            <path class="nagi-penguin__body" d="M9 1h6v1h3v1h2v2h1v3h1v7h-1v3h-2v2h-3v1H8v-1H5v-2H3v-3H2V8h1V5h1V3h2V2h3z" />
            <path class="nagi-penguin__body" d="M2 10H1v5h1v2h2v-2h1v-5H4v4H3v-4zm20 0h1v5h-1v2h-2v-2h-1v-5h1v4h1v-4z" />
            <path class="nagi-penguin__belly" d="M9 11h6v1h2v2h1v3h-1v1h-2v1H9v-1H7v-1H6v-3h1v-2h2z" />
            <g class="nagi-penguin__eyes"><path class="nagi-penguin__eye" d="M8 7h1v1H8zm7 0h1v1h-1z" /></g>
            <path class="nagi-penguin__beak" d="M11 9h2v1h1v1h-4v-1h1z" />
            <path class="nagi-penguin__feet" d="M7 21h4v2H6v-1h1zm6 0h4v1h1v1h-5z" />
          </svg>
        </summary>
        <span class="nagi-mascot__tooltip" role="status">build quietly.</span>
      </details>
    </div>
  </section>

  <section class="what-i-do" aria-labelledby="what-i-do-title">
    <div class="split-intro">
      <div id="about">
        <p class="eyebrow">01 · What I do</p>
        <h2 id="what-i-do-title">Curious across disciplines.</h2>
      </div>
      <p>
        我是 Nagi，一個還在摸索、研究，也一直動手做東西的學生。比起只待在單一領域，我更在意不同技術如何遇見真實需求，以及一個想法怎麼經過實驗成為能運作的東西。
      </p>
    </div>
    <div class="practice-threads">
      {practiceBlocks.map(([number, title, description], index) => (
        <article class:list={["board-region", "practice-thread", `practice-thread--${index + 1}`]}>
          <span>{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
          {index === 3 && (
            <div class="practice-thread practice-thread--security-context">
              <strong>{securityContext[1]}</strong>
              <span>{securityContext[2]}</span>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="board-region selected-work" id="selected-work" aria-labelledby="selected-title">
    <div>
      <div class="section-head">
        <div>
          <p class="eyebrow">02 · Selected work &amp; stories</p>
          <h2 id="selected-title">A few places to begin.</h2>
        </div>
        <p class="section-note">Four records that show how I research, build, compete, and rethink what I know.</p>
      </div>
      <div class="selected-list">
        {selectedWork.map(({ group, label, context }, index) => (
          <article class="selected-item" data-language-group data-group-key={group.key}>
            <span class="selected-number">{String(index + 1).padStart(2, '0')}</span>
            {group.availableLanguages.map((language) => {
              const article = group.variants[language]!;
              const defaultLanguage = group.variants.zh ? 'zh' : group.availableLanguages[0];
              return <div class="selected-variant" data-language-variant={language} hidden={language !== defaultLanguage}>
            <div class="selected-copy">
              <p class="selected-label">{label} · <span data-actual-language>{languageLabel[language]}</span></p>
              <h3><a href={article.href}>{article.data.title}</a></h3>
              <p>{context}</p>
            </div>
            <a class="selected-link" href={article.href} aria-label={`Read ${article.data.title}`}>Read →</a>
              </div>;
            })}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="board-region currently" aria-labelledby="currently-title">
    <div class="currently-layout">
      <div class="currently-intro">
        <p class="eyebrow">03 · Currently</p>
        <h2 id="currently-title">Questions in progress.</h2>
        <p>近期正在探索與關注的方向。它們不是完成清單，而是現在仍在持續理解的問題。</p>
      </div>
      <div class="current-list">
        {currentThreads.map(([title, description], index) => (
          <article class="current-thread">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="board-region home-notes" id="notes" aria-labelledby="notes-title">
    <div>
      <div class="notes-intro">
        <div>
          <p class="eyebrow">04 · Notes</p>
          <h2 id="notes-title">The longer record.</h2>
        </div>
        <div>
          <p>這裡保存研究、工程、競賽和生活裡持續形成的筆記。文章不是首頁的主角，而是理解這些經歷與想法的下一層。</p>
          <a class="button-link" href="https://notes.nagi.tw/">View all notes →</a>
          <span class="secondary-links"><a href="https://notes.nagi.tw/topics/">Topics</a><a href="https://notes.nagi.tw/archive/">Archive</a></span>
        </div>
      </div>
      <NotesPreview groups={recent} />
    </div>
  </section>

  <section class="board-region personal-connection" aria-labelledby="personal-title">
    <div class="personal-layout">
      <p class="eyebrow">05 · Along the way</p>
      <div>
        <h2 id="personal-title">Not only the finished work.</h2>
        <p>我想留下的不只有完成的技術，也包括比賽、失敗、一起走過的人，以及慢慢改變方向的過程。</p>
        <nav aria-label="Learn more about Nagi">
          <a href="#about">About Nagi →</a>
          <a href="https://notes.nagi.tw/articles/prologue-the-people-i-met-along-the-way/">Read the prologue →</a>
        </nav>
      </div>
    </div>
  </section>
  <aside class="board-region board-links" aria-label="Explore and connect">
    <p class="eyebrow">Explore</p>
    <nav>
      <a href="#about">About</a>
      <a href="#selected-work">Work</a>
      <a href="https://notes.nagi.tw/">Notes ↗</a>
      <a href="https://github.com/seraphforge">GitHub ↗</a>
    </nav>
  </aside>
  </div>
</BaseLayout>

<style>
  .research-board {
    width: min(calc(100vw - clamp(3rem, 5vw, 5rem)), 1760px);
    margin-inline: auto;
    padding: clamp(1rem, 2vw, 2rem) 0 clamp(3rem, 6vw, 6rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(11, minmax(58px, auto));
    grid-auto-flow: dense;
    gap: clamp(0.75rem, 1.15vw, 1.15rem);
  }

  .board-region {
    position: relative;
    min-width: 0;
    overflow: visible;
    border: 0;
    background: transparent;
  }

  .identity-hero {
    grid-column: 1 / 6;
    grid-row: 1 / 5;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 430px;
    padding: clamp(2rem, 4vw, 4.5rem);
    border-left: 3px solid var(--accent);
  }
  .hero-mascot {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 3.5vw, 3.5rem);
    z-index: 2;
    transform: translateY(-50%);
  }
  .nagi-mascot__easter-egg { position: relative; width: max-content; }
  .nagi-mascot__easter-egg summary { display: block; padding: 0; border: 0; background: transparent; cursor: pointer; list-style: none; }
  .nagi-mascot__easter-egg summary::-webkit-details-marker { display: none; }
  .nagi-mascot__easter-egg summary::marker { content: ""; }
  .nagi-mascot__easter-egg summary:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  .nagi-penguin { display: block; width: 96px; height: auto; color: var(--ink); transform-origin: 50% 100%; transition: transform 180ms ease; }
  .nagi-mascot__easter-egg summary:hover .nagi-penguin { transform: translateY(-2px); }
  .nagi-penguin__body, .nagi-penguin__pupil { fill: currentColor; }
  .nagi-penguin__belly, .nagi-penguin__eye { fill: #f3f5f3; }
  .nagi-penguin__beak, .nagi-penguin__feet { fill: #d89b4a; }
  .nagi-penguin__eyes { animation: nagi-penguin-blink 7s steps(1, end) infinite; }
  .nagi-mascot__tooltip { position: absolute; bottom: calc(100% + 0.55rem); left: 50%; padding: 0.3rem 0.45rem; border: 1px solid var(--line); background: var(--paper); color: var(--accent); font-family: var(--mono); font-size: 0.68rem; line-height: 1; white-space: nowrap; transform: translateX(-50%); }
  .nagi-mascot__easter-egg:not([open]) .nagi-mascot__tooltip { display: none; }
  @keyframes nagi-penguin-blink { 0%, 92%, 94%, 100% { opacity: 1; } 93% { opacity: 0; } }
  .identity-hero::after {
    position: absolute;
    right: clamp(1.5rem, 3vw, 3rem);
    bottom: clamp(1.5rem, 3vw, 3rem);
    width: clamp(2.5rem, 5vw, 5rem);
    aspect-ratio: 1;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: transparent;
    content: "";
  }
  .identity-hero::before {
    position: absolute;
    right: clamp(3.4rem, 6vw, 6rem);
    bottom: clamp(3.4rem, 6vw, 6rem);
    width: clamp(1.15rem, 2vw, 2rem);
    aspect-ratio: 1;
    background: var(--accent);
    content: "";
  }
  .identity-hero h1 {
    margin: clamp(1.5rem, 3vw, 3.5rem) 0 0;
    font-size: clamp(6.5rem, 12vw, 13rem);
    line-height: 0.76;
    letter-spacing: -0.085em;
  }
  .identity-line {
    max-width: 13ch;
    margin: clamp(2rem, 4vw, 4rem) 0 0;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.7vw, 3rem);
    line-height: 1.08;
  }
  .identity-intro {
    max-width: 36rem;
    margin: 1.25rem 0 2rem;
    color: var(--muted-readable);
    font-size: clamp(0.92rem, 1.15vw, 1.08rem);
  }
  .hero-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    max-width: calc(100% - 6rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .hero-links a { color: var(--ink); font-size: 0.8rem; }

  .what-i-do,
  .practice-threads { display: contents; }
  .split-intro {
    position: relative;
    grid-column: 6 / 9;
    grid-row: 3 / 5;
    align-self: stretch;
    padding: clamp(1.4rem, 2.5vw, 2.6rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .split-intro::after {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
    content: "";
  }
  .split-intro h2 {
    margin: 0.45rem 0 1rem;
    font-size: clamp(2rem, 3.1vw, 3.5rem);
  }
  .split-intro > p {
    max-width: 40ch;
    margin: 0;
    color: var(--muted-readable);
    font-size: 0.88rem;
  }

  .practice-thread {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 2vw, 2.1rem);
  }
  .practice-thread > span {
    color: var(--accent);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .practice-thread h3 {
    max-width: 12ch;
    margin: auto 0 0.75rem;
    font-size: clamp(1.45rem, 2.25vw, 2.55rem);
    line-height: 1;
  }
  .practice-thread > p {
    margin: 0;
    color: var(--muted-readable);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .practice-thread--1 {
    grid-column: 6 / 10;
    grid-row: 1 / 3;
    min-height: 205px;
    border-top: 6px solid var(--accent);
    background: transparent;
  }
  .practice-thread--2 {
    grid-column: 10 / 13;
    grid-row: 1 / 3;
    min-height: 205px;
    border-top: 6px solid var(--paper-yellow);
    background: transparent;
  }
  .practice-thread--3 {
    grid-column: 9 / 13;
    grid-row: 3 / 4;
    min-height: 205px;
    border-left: 6px solid var(--signal-lime);
    background: transparent;
  }
  .practice-thread--4 {
    grid-column: 9 / 13;
    grid-row: 4 / 5;
    min-height: 205px;
    border-bottom: 6px solid var(--clay);
    background: transparent;
  }
  .practice-thread--4 h3 {
    font-size: clamp(1.25rem, 1.65vw, 1.9rem);
    overflow-wrap: anywhere;
  }
  .practice-thread--4 > p { display: none; }
  .practice-thread--security-context {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border: 0;
    border-top: 1px solid var(--line);
    background: transparent;
    color: var(--muted-readable);
  }
  .practice-thread--security-context strong {
    font-family: var(--serif);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .practice-thread--security-context span {
    margin-top: 0.3rem;
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .selected-work {
    grid-column: 1 / 9;
    grid-row: 5 / 10;
    padding: clamp(1.6rem, 3vw, 3.2rem);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .selected-work::after {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 0.48rem;
    height: 0.48rem;
    background: var(--accent);
    content: "";
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.6fr);
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .section-head h2 {
    margin: 0.4rem 0 0;
    font-size: clamp(2.2rem, 4.2vw, 4.8rem);
  }
  .section-note { margin: 0; color: var(--muted-readable); font-size: 0.85rem; }
  .selected-list { border-top: 1px solid var(--line); }
  .selected-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: clamp(0.7rem, 1.4vw, 1.5rem);
    align-items: start;
    padding: clamp(1.05rem, 1.8vw, 1.65rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .selected-variant {
    display: grid;
    grid-column: 2;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(0.7rem, 1.4vw, 1.5rem);
    width: 100%;
  }
  .selected-copy { min-width: 0; }
  .selected-number {
    padding-top: 0.25rem;
    color: var(--accent);
    font-size: 0.68rem;
  }
  .selected-label {
    margin: 0 0 0.35rem;
    color: var(--muted-readable);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .selected-copy h3 {
    width: 100%;
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 2.15rem);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: normal;
    word-break: normal;
  }
  .selected-copy h3 a { color: var(--ink); text-decoration: none; }
  .selected-copy h3 a:hover { color: var(--accent); }
  .selected-copy > p:last-child {
    max-width: 50rem;
    margin: 0.45rem 0 0;
    color: var(--muted-readable);
    font-size: 0.8rem;
  }
  .selected-link { color: var(--ink); font-size: 0.74rem; white-space: nowrap; }

  .currently {
    grid-column: 9 / 13;
    grid-row: 5 / 7;
    padding: clamp(1.5rem, 2.5vw, 2.6rem);
    border-left: 4px solid var(--accent);
    background: var(--ice);
  }
  .currently-layout {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .currently-intro h2 {
    margin: 0.4rem 0 0.8rem;
    font-size: clamp(1.8rem, 2.6vw, 3rem);
  }
  .currently-intro > p:last-child { margin: 0; color: var(--muted-readable); font-size: 0.82rem; }
  .current-list { border-top: 1px solid var(--line); }
  .current-thread {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.55rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .current-thread > span { color: var(--accent); font-size: 0.65rem; }
  .current-thread h3 { margin: 0; font-size: clamp(1rem, 1.3vw, 1.25rem); }
  .current-thread p { margin: 0.2rem 0 0; color: var(--muted-readable); font-size: 0.72rem; }

  .home-notes {
    grid-column: 9 / 13;
    grid-row: 7 / 10;
    padding: clamp(1.5rem, 2.5vw, 2.6rem);
    border-top: 8px solid var(--paper-yellow);
    background: transparent;
  }
  .notes-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 1.35fr);
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .notes-intro h2 { margin: 0.35rem 0 0; font-size: clamp(1.8rem, 2.8vw, 3.2rem); }
  .notes-intro > div:last-child > p { margin: 0 0 0.8rem; color: var(--muted-readable); font-size: 0.78rem; }
  .button-link { display: inline-flex; color: var(--ink); font-size: 0.78rem; }
  .secondary-links { display: inline-flex; gap: 0.7rem; margin-left: 0.8rem; font-size: 0.72rem; }
  .secondary-links a { color: var(--muted-readable); }
  .home-notes :global(.article-index) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top-color: var(--line);
  }
  .home-notes :global(.article-row) {
    width: 100%;
    min-width: 0;
    padding: 0.9rem 0;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  .home-notes :global(.article-group) { width: 100%; min-width: 0; }
  .home-notes :global(.article-row:last-child) { border-bottom: 0; }
  .home-notes :global(.article-meta) { font-size: 0.6rem; }
  .home-notes :global(.article-row h2) {
    font-size: clamp(1rem, 1.25vw, 1.3rem);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .home-notes :global(.article-row h2),
  .home-notes :global(.article-row h2 a) { width: 100%; min-width: 0; overflow-wrap: normal; word-break: normal; }
  .home-notes :global(.article-row > p) { display: none; }

  .personal-connection {
    grid-column: 1 / 9;
    grid-row: 10 / 12;
    padding: clamp(1.6rem, 3vw, 3.2rem);
    border-top: 1px solid var(--line);
    background: transparent;
  }
  .personal-layout {
    display: grid;
    grid-template-columns: minmax(9rem, 0.4fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .personal-layout h2 { max-width: 42rem; margin: 0; font-size: clamp(2rem, 3.5vw, 4rem); }
